# Database connection string (Cloud PostgreSQL like Neon or Supabase)
DATABASE_URL=postgresql://user:password@ep-cool-project.region.neon.tech/neondb?sslmode=require

# Secret key for JWT token generation (create a long random string)
SECRET_KEY=generate_a_secure_random_string_here_32_characters_minimum

# Algorithm used for JWT encoding
ALGORITHM=HS256

# Token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed frontend origin (Optional, default allows all)
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
